# Server
PORT=5000
PUBLIC_API_URL=https://api.dmcamaster.com
CORS_ORIGINS=https://dmcamaster.com,https://www.dmcamaster.com

# Authentication
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES=7d
ADMIN_LOGIN_NAME=DMCA Master Admin
ADMIN_LOGIN_EMAIL=admin@dmcamaster.com
ADMIN_LOGIN_PASSWORD=DmcaMaster@2026

# Email / Hostinger SMTP
EMAIL_FROM_NAME=DMCA Master
EMAIL_FROM_ADDRESS=legal@dmcamaster.com
EMAIL_PASS=replace-with-mailbox-password
ADMIN_EMAIL=legal@dmcamaster.com
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true

# Hostinger MySQL
DB_HOST=your-hostinger-mysql-host
DB_PORT=3306
DB_USER=your-database-user
DB_PASS=your-database-password
DB_NAME=your-database-name
DB_SSL=false
